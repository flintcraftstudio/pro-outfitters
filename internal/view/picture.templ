package view

// picture — a content image as a <picture> with AVIF and WebP sources and the
// original JPG as fallback. `src` is the full /static/img/foo.jpg path; the
// AVIF/WebP siblings are derived from it. `class` lands on the inner <img>, and
// the <picture> uses display:contents so those layout classes resolve against
// the real parent (grid cell, flex item) exactly as a bare <img> would.
templ picture(src, alt, class string) {
	<picture class="contents">
		<source srcset={ imgVariant(src, ".avif") } type="image/avif"/>
		<source srcset={ imgVariant(src, ".webp") } type="image/webp"/>
		<img src={ assetPath(src) } alt={ alt } class={ class } loading="lazy" decoding="async"/>
	</picture>
}

// sizedPicture — a lazy content image with responsive AVIF/WebP srcsets (the
// base JPG is the <img> fallback),
// for images that render large enough to need them (the gallery). `sizes` is
// the rendered-width hint for the image's placement. Requires the width
// variants imgSrcset names; imgFocus applies as for bleedPicture.
templ sizedPicture(src, alt, class, sizes string) {
	<picture class="contents">
		<source type="image/avif" srcset={ imgSrcset(src, ".avif") } sizes={ sizes }/>
		<source type="image/webp" srcset={ imgSrcset(src, ".webp") } sizes={ sizes }/>
		<img
			src={ assetPath(src) }
			alt={ alt }
			class={ withFocus(src, class) }
			loading="lazy"
			decoding="async"
		/>
	</picture>
}

// bleedPicture — a full-bleed image with responsive AVIF/WebP srcsets at
// 100vw, and the base JPG as the <img> fallback. Pass eager=true for the page's LCP hero (fetchpriority=high, eager);
// false for below-the-fold bands so they don't compete with the hero. Images
// listed in imgFocus get their focal-point class added to `class`.
templ bleedPicture(src, alt, class string, eager bool) {
	<picture class="contents">
		<source type="image/avif" srcset={ imgSrcset(src, ".avif") } sizes="100vw"/>
		<source type="image/webp" srcset={ imgSrcset(src, ".webp") } sizes="100vw"/>
		<img
			src={ assetPath(src) }
			alt={ alt }
			class={ withFocus(src, class) }
			decoding="async"
			if eager {
				fetchpriority="high"
				loading="eager"
			} else {
				loading="lazy"
			}
		/>
	</picture>
}
