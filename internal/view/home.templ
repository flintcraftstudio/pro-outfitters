package view

templ HomePage() {
	@Base("Montana, the way it was meant to be fished", "Owner-operated fly fishing and bird hunting in Montana since 1970. Guided float trips, upland wingshooting, and three lodges on water worth protecting.", homeContent())
}

templ homeContent() {
	@homeHero()
	@homeStory()
	@homeExperiences()
	@homeLodges()
	@homeOwner()
	@homeStewardship()
	@homeTestimonial()
	@homeClosing()
}

// ---- Hero ----------------------------------------------------------------
templ homeHero() {
	<!-- Phones stack the hero: a fixed crop framing the raft on top, the
	     text on the dark ground below. A tall viewport only shows about a
	     quarter of this wide image, and the raft sits in the lower third
	     where an overlaid headline would cover it. From sm up the photo goes
	     full-bleed behind the text as before. -->
	<header data-hero class="relative isolate flex flex-col bg-po-ground-dark text-po-on-dark sm:min-h-screen sm:flex-row sm:items-end sm:bg-transparent">
		<div class="relative h-[46svh] min-h-[18rem] w-full sm:absolute sm:inset-0 sm:-z-20 sm:h-full sm:min-h-0">
			@bleedPicture("/static/img/hero-fishing.jpg", "A guided raft float on a Montana river", "po-hero-img absolute inset-0 h-full w-full object-cover", true)
			<!-- Phone-only: a light top darkening for the nav, and a fade at
			     the foot so the photo settles into the text panel. -->
			<div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(16,14,11,0.45)_0%,rgba(16,14,11,0)_28%,rgba(16,14,11,0)_78%,rgba(20,18,15,1)_100%)] sm:hidden"></div>
		</div>
		<!-- sm+ protection gradients tuned to this bright, high-key image: a
		     bottom-anchored vertical scrim carries the text block, a light top
		     darkening keeps the nav legible over pale sky, and a left
		     directional scrim covers the left-aligned text column. -->
		<div class="absolute inset-0 -z-10 hidden bg-[linear-gradient(180deg,rgba(16,14,11,0.45)_0%,rgba(16,14,11,0.08)_20%,rgba(16,14,11,0)_48%,rgba(16,14,11,0.60)_70%,rgba(16,14,11,0.92)_100%)] sm:block"></div>
		<div class="absolute inset-0 -z-10 hidden bg-[linear-gradient(90deg,rgba(16,14,11,0.45)_0%,rgba(16,14,11,0.12)_40%,rgba(16,14,11,0)_65%)] sm:block"></div>
		<div class="mx-auto w-full max-w-container px-6 pb-12 pt-6 sm:px-12 sm:pb-[clamp(3rem,7vh,6rem)] sm:pt-32">
			@eyebrow("Est. 1970 · Orvis-Endorsed · Montana", "light")
			<h1 class="mt-4 max-w-[16ch] text-balance font-display text-[2.5rem] font-normal leading-[1.04] tracking-[-0.015em] text-po-on-dark sm:mt-6 sm:text-[clamp(2.9rem,6.4vw,5.6rem)] sm:leading-[1.02] sm:[text-shadow:0_1px_24px_rgba(16,14,11,0.35)]">Montana, the way it was meant to be fished.</h1>
			<p class="mt-4 max-w-[46ch] font-display text-[1.125rem] font-light leading-[1.5] text-po-on-dark-soft sm:mt-6 sm:text-[clamp(1.25rem,2.1vw,1.5rem)] sm:text-po-on-dark">Guided float trips, upland wingshooting, and three owner-operated lodges on water worth protecting.</p>
			<!-- Phones lead with the call (most guests book by phone, and two
			     full buttons don't fit side by side); from sm up the inquiry
			     is the filled primary and the number sits beside it. -->
			<div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4 sm:hidden">
				@btnPrimaryLight("Call "+BrandPhone, BrandPhoneHref)
				@linkArrowLight("Plan your trip", "/contact")
			</div>
			<div class="mt-10 hidden flex-wrap items-center gap-4 sm:flex">
				@btnPrimaryLight("Plan your trip", "/contact")
				@btnGhost("Call "+BrandPhone, BrandPhoneHref)
			</div>
		</div>
	</header>
}

// ---- Story teaser --------------------------------------------------------
templ homeStory() {
	<section class="bg-po-paper-deep py-[clamp(5rem,11vh,10rem)]">
		<div class="mx-auto max-w-container px-6 sm:px-12">
			<div class="reveal grid items-center gap-[clamp(2.5rem,6vw,6rem)] md:grid-cols-[1.05fr_0.95fr]">
				<div>
					@picture("/static/img/story-flybox.jpg", "A guide sorting flies from a fly box in the boat", "aspect-[4/5] w-full rounded-sm object-cover")
				</div>
				<div>
					@eyebrow("Owner-operated", "gold")
					<h2 class="my-5 max-w-[18ch] font-display text-[clamp(2rem,4vw,3rem)] font-normal leading-[1.12] tracking-[-0.015em] text-po-ink">An authentic taste of Montana before.</h2>
					<p class="mb-7 max-w-[46ch]">We've spent fifty years earning access to water most people never see — and learning when to leave it alone.</p>
					@linkArrow("Read our story", "/about")
				</div>
			</div>
		</div>
	</section>
}

// ---- Experiences ---------------------------------------------------------
templ homeExperiences() {
	<section class="bg-po-paper py-[clamp(5rem,11vh,10rem)]">
		<div class="mx-auto max-w-container px-6 sm:px-12">
			<div class="reveal mb-[clamp(2.5rem,5vw,4rem)]">
				@sectionHead("Two ways to spend a Montana day", "Fly fishing & bird hunting.")
			</div>
			<div class="grid gap-[clamp(1.5rem,3vw,2.5rem)] md:grid-cols-2">
				@experienceCard("exp-fishing", "fishing-alt1.jpg", "A guest with a fish on, rod bent, fishing from the raft", "Fly Fishing", "Trout water, read by people who live on it.", "Wade and float the Missouri, the Blackfoot, and tailwaters that fish all season. Guides who'll tell you the truth about the hatch.", "Explore fly fishing", "/fly-fishing")
				@experienceCard("exp-hunting", "exp-hunting.jpg", "Dogs on point, autumn prairie", "Bird Hunting", "Upland miles behind a good dog.", "Sharptail, Hun, and pheasant over big country. Mornings that start in frost and end with the truck a long, satisfied walk away.", "Explore wingshooting", "/bird-hunting")
			</div>
		</div>
	</section>
}

templ experienceCard(id, img, alt, label, headline, body, linkLabel, href string) {
	<article id={ id } class="reveal flex flex-col">
		@picture("/static/img/"+img, alt, "aspect-[5/4] w-full rounded-sm object-cover")
		<div class="pt-6">
			@eyebrow(label, "gold")
			<h3 class="mb-3 mt-3 font-display text-[clamp(1.6rem,2.6vw,2.1rem)] font-medium leading-[1.2] text-po-ink">{ headline }</h3>
			<p class="mb-5 max-w-[40ch] text-[1.0625rem] text-po-gray">{ body }</p>
			@linkArrow(linkLabel, href)
		</div>
	</article>
}

// ---- The Lodges ----------------------------------------------------------
templ homeLodges() {
	<section class="bg-po-paper-deep py-[clamp(5rem,11vh,10rem)]">
		<div class="mx-auto max-w-container px-6 sm:px-12">
			<div class="reveal mb-[clamp(2.5rem,5vw,4rem)] flex flex-wrap items-end justify-between gap-8">
				@sectionHead("The Lodges", "Three places to wake up on the water.")
				<div class="mb-2">
					@linkArrow("All lodges", "/lodges")
				</div>
			</div>
			<div class="grid gap-[clamp(1.25rem,2.5vw,2rem)] sm:grid-cols-2 lg:grid-cols-3">
				for _, l := range Lodges() {
					@lodgeCard(l)
				}
			</div>
		</div>
	</section>
}

templ lodgeCard(l Lodge) {
	<article class="reveal group flex flex-col overflow-hidden rounded-sm border border-po-border bg-po-surface transition-all duration-[600ms] ease-editorial hover:-translate-y-1 hover:border-po-border-strong">
		<div class="overflow-hidden">
			@picture("/static/img/"+l.CardImage, l.Name, "aspect-[4/3] w-full object-cover transition-transform duration-[1100ms] ease-editorial group-hover:scale-[1.04]")
		</div>
		<div class="flex flex-1 flex-col px-6 pb-7 pt-6">
			<div class="mb-3 flex flex-wrap gap-x-4 gap-y-1 text-[0.75rem] font-semibold uppercase tracking-[0.1em] text-po-gold-deep">
				for _, t := range l.MetaTags {
					<span>{ t }</span>
				}
			</div>
			<h3 class="mb-2 font-display text-[1.4rem] font-medium leading-[1.2] text-po-ink">{ l.Name }</h3>
			<p class="mb-5 text-[0.9375rem] leading-[1.55] text-po-gray">{ l.CardBlurb }</p>
			<div class="mt-auto">
				@linkArrowSR("Explore", l.Name, "/lodges/"+l.Slug)
			</div>
		</div>
	</article>
}

// ---- Owner -------------------------------------------------------------
// A face, a name, and the office number: the trust signal this audience
// actually acts on (most guests book by phone). Replaces a stat band.
templ homeOwner() {
	<section class="bg-po-ground-dark py-[clamp(5rem,11vh,9rem)] text-po-on-dark">
		<div class="mx-auto max-w-container px-6 sm:px-12">
			<div class="reveal grid items-center gap-[clamp(2.5rem,6vw,6rem)] md:grid-cols-[0.95fr_1.05fr]">
				<div>
					@picture("/static/img/owner-brandon.jpg", "Brandon Boedecker holding a brown trout on the river", "aspect-[4/3] w-full rounded-sm object-cover")
				</div>
				<div class="max-w-[42ch]">
					@eyebrow("Owner & guide", "light")
					<h2 class="my-5 font-display text-[clamp(1.9rem,3.6vw,2.8rem)] font-normal leading-[1.15] tracking-[-0.015em] text-po-on-dark">Owner-operated means the owner is on the water.</h2>
					<p class="text-po-on-dark-soft">Brandon Boedecker rows boats on the Smith through spring and summer, and chases wild birds behind his dogs at Sharptail Lodge come fall.</p>
					<div class="mt-9 border-t border-white/15 pt-7">
						@eyebrow("Call the office", "light")
						<a href={ templ.SafeURL(BrandPhoneHref) } class="mt-3 inline-block font-display text-[clamp(2rem,3.6vw,2.75rem)] font-light leading-none text-po-on-dark transition-colors duration-500 ease-editorial hover:text-po-gold">{ BrandPhone }</a>
						<p class="mt-5 text-[0.9375rem] text-po-on-dark-soft">Prefer to write? <a href="/contact" class="text-po-on-dark underline decoration-white/40 underline-offset-4 transition-colors hover:decoration-po-gold">Plan your trip</a> online.</p>
					</div>
				</div>
			</div>
		</div>
	</section>
}

// ---- Stewardship ---------------------------------------------------------
templ homeStewardship() {
	<section class="bg-po-paper py-[clamp(5rem,11vh,10rem)]">
		<div class="mx-auto max-w-container px-6 sm:px-12">
			<div class="reveal grid items-center gap-[clamp(2.5rem,6vw,6rem)] md:grid-cols-[0.95fr_1.05fr]">
				<div>
					@picture("/static/img/steward-smith.jpg", "The Smith River canyon", "aspect-square w-full rounded-sm object-cover")
				</div>
				<div class="max-w-[44ch]">
					@eyebrow("Stewardship", "gold")
					<h2 class="my-5 max-w-[16ch] font-display text-[clamp(1.9rem,3.6vw,2.8rem)] font-normal leading-[1.15] tracking-[-0.015em] text-po-ink">You can't sell a river twice.</h2>
					<p class="mb-5">The water that makes a trip worth taking is the same water we intend to hand to the next fifty years. We fish like we plan to keep it.</p>
					<p class="mb-5">We partner with Trout Unlimited on habitat and cold-water restoration across the watersheds we guide, and we limit the days we run so the rivers never feel crowded.</p>
					<div class="mt-8 flex flex-wrap gap-6 border-t border-po-border pt-6 text-[0.75rem] font-semibold uppercase tracking-[0.1em] text-po-gray">
						<span>Trout Unlimited partner</span>
						<span>Catch &amp; release waters</span>
						<span>Limited daily access</span>
					</div>
				</div>
			</div>
		</div>
	</section>
}

// ---- Testimonial ---------------------------------------------------------
templ homeTestimonial() {
	<section class="bg-po-paper-deep py-[clamp(5rem,11vh,10rem)] text-center">
		<div class="reveal mx-auto max-w-[54rem] px-6 sm:px-12">
			<span class="mb-4 block font-display text-[5rem] leading-[0] text-po-gold" style="height:2.2rem">&ldquo;</span>
			<blockquote class="text-balance font-display text-[clamp(1.7rem,3.6vw,2.9rem)] font-light italic leading-[1.32] tracking-[-0.01em] text-po-ink">The fishing was extraordinary. But what I remember is how quiet it was — like we'd been let in on something the rest of the country forgot.</blockquote>
			<cite class="mt-8 block text-[0.8125rem] font-semibold uppercase not-italic tracking-[0.13em] text-po-gray-light">&mdash; Guest, North Fork Crossing · returning since 2016</cite>
		</div>
	</section>
}

// ---- Closing CTA ---------------------------------------------------------
templ homeClosing() {
	<section class="relative isolate overflow-hidden text-center text-po-on-dark">
		@bleedPicture("/static/img/fishing-alt2.jpg", "A wild Montana trout", "absolute inset-0 -z-10 h-full w-full object-cover", false)
		<div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(16,14,11,0.66),rgba(16,14,11,0.78))]"></div>
		<div class="mx-auto max-w-container px-6 py-[clamp(6rem,14vh,11rem)] sm:px-12">
			@eyebrow("Plan your trip", "light")
			<h2 class="mx-auto my-5 max-w-[18ch] text-balance font-display text-[clamp(2.3rem,5vw,4rem)] font-normal leading-[1.12] tracking-[-0.015em] text-po-on-dark">Tell us what kind of week you're after.</h2>
			<p class="mx-auto mb-10 max-w-[40ch] text-po-on-dark-soft">Every trip is planned by hand. Call the office, or send your dates and what you're hoping for, and we'll take it from there.</p>
			<div class="flex flex-wrap justify-center gap-4">
				@btnPrimaryLight("Call "+BrandPhone, BrandPhoneHref)
				@btnGhost("Plan your trip", "/contact")
			</div>
		</div>
	</section>
}
